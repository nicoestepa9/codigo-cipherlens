# CryptoGuard Backend - Environment Configuration
# Copy this file to .env.local and fill in your own values.
#   Windows (PowerShell):  Copy-Item .env.example .env.local
#   Linux/macOS:           cp .env.example .env.local

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
# Default seguro: production. En desarrollo setea ENV=dev explicitamente.
# ENV=production | dev
# ENV=dev
# EXPOSE_DOCS=false
# DISABLE_API_AUTH solo se acepta con ENV=dev (con otro ENV la app no arranca).
# DISABLE_API_AUTH=false

# ---------------------------------------------------------------------------
# Database (default: SQLite stored as cryptoguard.db)
# ---------------------------------------------------------------------------
# DATABASE_URL=sqlite:///cryptoguard.db
# PostgreSQL (requiere DATABASE_URL=postgresql+psycopg://...)
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=1800

# ---------------------------------------------------------------------------
# CORS (comma-separated list of allowed origins; default: *)
# ---------------------------------------------------------------------------
# CORS_ORIGINS=*

# ---------------------------------------------------------------------------
# Auth (JWT + refresh tokens)
# ---------------------------------------------------------------------------
# JWT_SECRET=generate_with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# ACCESS_TOKEN_MINUTES=15
# REFRESH_TOKEN_DAYS=7
# COOKIE_SECURE=true
# LOGIN_MAX_FAILURES=5
# LOGIN_LOCKOUT_MINUTES=15
# AUTH_RATE_LIMIT_PER_MINUTE=10
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
# ARGON2_TIME_COST=3
# ARGON2_MEMORY_COST=65536
# ARGON2_PARALLELISM=4

# ---------------------------------------------------------------------------
# AI Provider: "template" (deterministic, no key) | "anthropic" | "gemini"
# ---------------------------------------------------------------------------
# AI_PROVIDER=template
# AI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=your_gemini_api_key_here
# AI_MODEL=claude-3-5-sonnet-latest
# AI_ANONYMIZATION=internal  # internal | strict | off
# AI_INTERNAL_DOMAINS=corp.internal,lan
# AI_FIELD_MAX_LEN=200
# AI_OUTPUT_MAX_CHARS=30000
# AI_LINK_ALLOWLIST=nvd.nist.gov,csrc.nist.gov,nvlpubs.nist.gov,datatracker.ietf.org
# AI_LOG_PROMPTS=false
# AI_API_URL=https://api.anthropic.com/v1/messages

# ---------------------------------------------------------------------------
# Scanner
# ---------------------------------------------------------------------------
# SCAN_TIMEOUT=10.0
# MAX_CONCURRENT_SCANS=5
# SCHEDULED_SCAN_FAIL_THRESHOLD=3
# SCAN_TICK_INTERVAL_MINUTES=15
# CLOUD_SCAN_BLOCK_PRIVATE=true
# CLOUD_DISCOVERY_MAX_HOSTS=256
# DEFAULT_MAX_AGENTS=10
# DEFAULT_MAX_CLOUD_SCANS_PER_HOUR=60
# DEFAULT_MAX_RECURRING_SCANS=10
# Agent task lifecycle
# AGENT_TASK_LEASE_SECONDS=600
# AGENT_TASK_MAX_ATTEMPTS=3
# AGENT_TASK_TTL_SECONDS=3600

# ---------------------------------------------------------------------------
# Alerts
# ---------------------------------------------------------------------------
# ALERTS_ENABLED=true
# ALERTS_INTERVAL_MINUTES=15

# ---------------------------------------------------------------------------
# Issues / SLA (Parte 2)
# ---------------------------------------------------------------------------
# ISSUE_MIN_SEVERITY=medium
# ISSUE_VERIFY_AFTER_CLEAN_SCANS=2
# SLA_DAYS_CRITICAL=7
# SLA_DAYS_HIGH=30
# SLA_DAYS_MEDIUM=90
# RISK_ACCEPTANCE_MAX_DAYS=365
