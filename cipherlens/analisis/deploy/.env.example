# Copiar a deploy/.env y completar. No commitear el .env real.
#   Copy-Item deploy/.env.example deploy/.env      (PowerShell)
#   cp deploy/.env.example deploy/.env             (Linux/macOS)

# Dominio publico del backend detras de Caddy. Para una prueba local usar
# localhost (Caddy emite un certificado interno). En produccion debe resolver
# a esta VM y permitir 80/443 para ACME.
CRYPTOGUARD_DOMAIN=cryptoguard.example.com

# Password de PostgreSQL. Usar solo caracteres URL-safe (A-Z a-z 0-9 . _ ~ -)
# porque se interpola dentro de DATABASE_URL. Alternativamente, sobreescribir
# DATABASE_URL completo con un valor URL-encoded.
POSTGRES_PASSWORD=cambiar-por-un-secreto-largo-y-aleatorio

# Secreto de firma JWT (>= 32 bytes). Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=cambiar-por-un-secreto-de-al-menos-48-caracteres

# Origen exacto del frontend (no usar *). Puede ser una lista separada por comas.
# Ejemplo: https://app.example.com
CORS_ORIGINS=https://app.example.com

# Bootstrap inicial del primer administrador (opcional pero recomendado).
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=cambiar-por-un-password-inicial-fuerte

# Ajustes opcionales
TZ=UTC
LOG_LEVEL=INFO
AI_PROVIDER=template
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
MAX_CONCURRENT_SCANS=5
ALERTS_ENABLED=true
