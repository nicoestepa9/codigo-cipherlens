# Copiar a `.env` y completar. NO commitear el .env real.
#
# URL base del backend CryptoGuard.
# - Si Grafana corre en Docker y el backend en el host: http://host.docker.internal:8000
# - Si backend y Grafana comparten red de Docker: http://cryptoguard-api:8000
CRYPTOGUARD_URL=http://host.docker.internal:8000

# ApiKey de rol "viewer" creada por un admin (ver README.md).
CRYPTOGUARD_API_KEY=cg_reemplazar_por_una_key_viewer

# Credenciales de administracion de Grafana (cambiar en produccion).
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=admin
